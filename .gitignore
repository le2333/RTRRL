# --- monorepo root ---
# This repo is a monorepo: rtrrl/ (streaming-rtrrl, JAX 0.5), memo/ (memorax-rtrl,
# JAX 0.10), and infra/ (shared jax-free orchestration + HPO). Each subproject has
# its own .gitignore for its subtree; the rules below cover repo-root leftovers.

# Runtime / data left at the repo root by the pre-monorepo layout. The live Aim
# server (cwd = repo root, --repo .aim) and the old streaming venv still point
# here; these are huge/regenerable and must never be tracked.
/.aim/
/.venv/
/wandb/
/logs/
/archive/
/__pycache__/

# Ephemeral Aim "test" repo for debug runs (AIM_SCRATCH_REPO, see logging_util).
# Validation-only, never backed up to S3; safe to delete anytime.
.aim-scratch/

# Global safety net (subprojects also ignore these within their own trees).
**/__pycache__/
**/.venv/
*.py[cod]
