FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:bb38f0ebd7d5d42c60d46a72cc8dbf2ed66c7263212f3b94a8ddfe2b60f7f8ca /uv /usr/local/bin/uv
# memorax still pulls lox from a git branch, so the resolver needs a git client.
RUN apt-get update \
 && apt-get install --no-install-recommends -y git \
 && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy
WORKDIR /workspace/memo
COPY training-sdk /workspace/training-sdk
COPY memo /workspace/memo
RUN uv sync --frozen --no-dev --no-editable --extra cuda12 && uv cache clean

FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS runtime

ARG TRAINER_CATALOG_V2
RUN test -n "${TRAINER_CATALOG_V2}"
LABEL org.rtrrl.trainer.catalog.v2="${TRAINER_CATALOG_V2}"
COPY --from=builder /opt/venv /opt/venv
COPY memo/catalog.json /opt/trainer/catalog.json
# No JAX_PLATFORM_NAME here: the CUDA plugin picks the GPU when the driver is
# visible, and pinning a platform would hide a job that landed without one.
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1
CMD ["python", "-m", "training_sdk.worker"]
