#!/usr/bin/env bash
# Per-project overrides for the shared infra (trainer/infra). Sourced by
# ../infra/env.sh after it sets the common AWS resources. AWS resource names
# stay shared (rtrrl-*); memorax-rtrl is distinguished only by image tag and
# its own W&B project.

export PROJECT_NAME="memorax-rtrl"

# ECR image tags (one shared ECR repo, distinguished by tag). memorax-rtrl needs
# jax 0.10 (RNN.local_jacobian etc.), so its image is a SEPARATE tag from
# streaming-rtrrl's jax-0.5 image.
export IMAGE_TAG="${IMAGE_TAG:-memorax-rtrl-cpu}"
export GPU_IMAGE_TAG="${GPU_IMAGE_TAG:-memorax-rtrl-gpu}"

# Default in-container entry (relative to /app). Callers override with --entry.
export DEFAULT_ENTRY="experiments/stream_ac_memorychain/run.py"

# memorax-rtrl runs log to their OWN W&B project (don't mix with RTRRL-PPO).
export WANDB_PROJECT="${WANDB_PROJECT:-memorax-rtrl}"
