FROM python:3.12-slim AS builder

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends git ca-certificates build-essential \
    && rm -rf /var/lib/apt/lists/*

ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy

WORKDIR /workspace/memo
COPY training-sdk /workspace/training-sdk
COPY memo/pyproject.toml memo/uv.lock /workspace/memo/
RUN uv sync --frozen --no-dev --no-editable --extra brax --extra facility --extra cuda12 \
    --no-install-project \
    && find /opt/venv -name '*.a' -delete \
    && uv cache clean

FROM python:3.12-slim AS runtime

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ARG TRAINER_SCRIPT_CATALOG
RUN test -n "${TRAINER_SCRIPT_CATALOG}"
LABEL org.rtrrl.trainer.scripts.v1="${TRAINER_SCRIPT_CATALOG}"

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY memo /app
COPY rtrrl/infra/worker/worker.py /opt/trainer/worker.py
COPY memo/infra/scripts /opt/trainer/scripts

CMD ["python", "/opt/trainer/worker.py", "--help"]
