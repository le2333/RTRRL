FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.25@sha256:bb38f0ebd7d5d42c60d46a72cc8dbf2ed66c7263212f3b94a8ddfe2b60f7f8ca /uv /usr/local/bin/uv
# Two things the resolver cannot do without. The fork pulls popjym from a git
# revision, so it needs a git client; and brax 0.10.5 -- the last release before
# 0.11, which is where their pin holds them -- depends on pytinyrenderer, which
# publishes no wheel for this interpreter and so is compiled here from its
# sources. Neither reaches the runtime stage.
RUN apt-get update \
 && apt-get install --no-install-recommends -y git build-essential \
 && rm -rf /var/lib/apt/lists/*
ENV UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy
WORKDIR /workspace/rtrrl
COPY training-sdk /workspace/training-sdk
# Only the manifest, because the project is declared `package = false`: uv
# installs its dependencies and never the fork itself, so the sources belong in
# the runtime stage where they cost one layer instead of two.
COPY rtrrl/pyproject.toml rtrrl/uv.lock rtrrl/README.md /workspace/rtrrl/
RUN uv sync --frozen --no-dev --no-editable && uv cache clean

FROM python:3.12.11-slim-bookworm@sha256:c00fc7b44d844b6da22861ec24af43968a5200eac4ec607b4725d585165d6b49 AS runtime

ARG TRAINER_CATALOG_V2
RUN test -n "${TRAINER_CATALOG_V2}"
LABEL org.rtrrl.trainer.catalog.v2="${TRAINER_CATALOG_V2}"
COPY --from=builder /opt/venv /opt/venv
# The fork, as an import root rather than as an installed distribution. Their
# modules import each other by bare name -- `from traces import ...`, `from
# models.online_lru import ...` -- which only resolves with the project root
# itself on the path, and packaging it to change that would be the one kind of
# edit this arm exists to avoid.
COPY rtrrl/entries /opt/rtrrl/entries
COPY rtrrl/envs /opt/rtrrl/envs
COPY rtrrl/models /opt/rtrrl/models
COPY rtrrl/*.py /opt/rtrrl/
COPY rtrrl/catalog.json /opt/trainer/catalog.json
WORKDIR /opt/rtrrl
ENV PATH="/opt/venv/bin:${PATH}" \
    PYTHONPATH=/opt/rtrrl \
    PYTHONUNBUFFERED=1 \
    JAX_PLATFORM_NAME=cpu
CMD ["python", "-m", "training_sdk.worker"]
