FROM python:3.13-slim-bookworm

# boto3 only bootstraps the authenticated S3 download. The numerical stack is
# installed at run time, offline, from the SHA256-verified archived wheelhouse.
RUN apt-get update \
 && apt-get install --no-install-recommends -y build-essential \
 && rm -rf /var/lib/apt/lists/*
RUN python -m pip install --no-cache-dir boto3
COPY rtrrl/scripts/hc_cpu_repro_gate.py /opt/rtrrl/hc_cpu_repro_gate.py
COPY rtrrl/config/hc_bp_step200001_oai_reference.tsv /opt/rtrrl/hc_bp_step200001_oai_reference.tsv
ENV JAX_PLATFORM_NAME=cpu PYTHONUNBUFFERED=1
CMD ["python", "/opt/rtrrl/hc_cpu_repro_gate.py"]
