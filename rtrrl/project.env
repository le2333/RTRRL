#!/usr/bin/env bash
# Per-project overrides for the shared infra (trainer/infra). Sourced by
# ../infra/env.sh after it sets the common AWS resources. Only the bits that
# differ per project live here; AWS resource names stay shared (rtrrl-*).

export PROJECT_NAME="streaming-rtrrl"

# ECR image tags (one shared ECR repo, distinguished by tag).
export IMAGE_TAG="${IMAGE_TAG:-cpu}"
export GPU_IMAGE_TAG="${GPU_IMAGE_TAG:-gpu}"

# Default in-container entry script (relative to /app). Callers override with
# --entry; HPO specs set their own entry (e.g. ppo_baseline.py).
export DEFAULT_ENTRY="rtrrl.py"

# W&B project for this repo's runs (see ppo_baseline.py).
export WANDB_PROJECT="${WANDB_PROJECT:-RTRRL-PPO}"
